# Required -- server will fail to start without these
# On-prem NavUserPassword:
BC_BASE_URL=http://Cronus27/BC
BC_USERNAME=
BC_PASSWORD=

# SaaS / Entra (OAuth). A businesscentral.dynamics.com URL auto-selects OAuth
# and does not require BC_USERNAME / BC_PASSWORD.
# BC_BASE_URL=https://businesscentral.dynamics.com/00000000-0000-0000-0000-000000000000/DEV
# BC_AUTH=OAuth
# BC_CLIENT_ID=
# BC_CLIENT_SECRET=          # set this for client-credentials (S2S); omit for device code
# BC_AAD_TENANT_ID=          # optional when the tenant is in BC_BASE_URL
# BC_ACCESS_TOKEN=           # optional pre-acquired Bearer token
# BC_OAUTH_SCOPE=            # default: user_impersonation (device code) or .default (S2S)

# Optional
BC_TENANT_ID=default
BC_CLIENT_VERSION=27.0.0.0
# BC profile id (e.g. "BUSINESS MANAGER"). Server uppercases and trims;
# unknown id silently falls back to user default. Empty = server default.
# Affects which Role Center loads and which pages Tell Me indexes.
# BC_PROFILE=
# navigationContext.applicationId sent in OpenSession/Invoke. Default "FIN"
# (SaaS / cronus images). Some on-prem BC27 ltsc2025 containers require "NAV" --
# with "FIN" the server throws NavCancelCredentialPromptException on OpenSession
# even though the WS handshake succeeds. Set to NAV only if you hit that error.
# BC_APPLICATION_ID=FIN
PORT=3000
LOG_LEVEL=info
LOG_DIR=./logs
STATE_DIR=./.state
